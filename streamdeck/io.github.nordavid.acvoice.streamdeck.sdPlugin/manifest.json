{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "AC Voice",
	"Version": "0.1.0.0",
	"Author": "David Einenkel",
	"Description": "Voice control for ActiveCollab. Tap the key and speak. AC Voice opens projects, tickets and your tasks in Chrome.",
	"Category": "AC Voice",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "26"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "disabled"
	},
	"UUID": "io.github.nordavid.acvoice.streamdeck",
	"ApplicationsToMonitor": {
		"mac": ["io.github.nordavid.acvoice"]
	},
	"Actions": [
		{
			"Name": "AC Voice",
			"UUID": "io.github.nordavid.acvoice.streamdeck.voice",
			"Icon": "imgs/actions/voice/icon",
			"Tooltip": "Tap and speak. Or hold the key while you speak.",
			"Controllers": ["Keypad"],
			"UserTitleEnabled": false,
			"SupportedInMultiActions": false,
			"States": [
				{
					"Image": "imgs/actions/voice/key",
					"ShowTitle": false
				}
			],
			"PropertyInspectorPath": "ui/voice.html"
		}
	]
}

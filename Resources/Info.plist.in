<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template for "AC Voice.app/Contents/Info.plist", rendered by scripts/bundle.sh.
  Placeholders: @VERSION@ (VERSION file, else 0.1.0) and @BUILD_NUMBER@ (UTC timestamp, or $BUILD_NUMBER).
  bundle.sh also adds ACVoiceSourceRoot (the package folder) for the setup window's Stream Deck commands, except with
  EMBED_SOURCE_ROOT=0 (scripts/release.sh), and copies Resources/de.lproj and Resources/en.lproj (InfoPlist.strings)
  into Contents/Resources.
  The usage descriptions appear in the macOS permission prompts. The lproj folders hold them in German and English, and
  macOS picks one by the system language (config.json "language" does not reach these prompts). The English texts
  below are the fallback. The development region is English, so every other system language gets English, as in the
  app itself, and AppKit's own texts (Cut, Copy, Paste) follow the system language too.
-->
<plist version="1.0">
<dict>
	<key>CFBundleIdentifier</key>
	<string>io.github.nordavid.acvoice</string>
	<key>CFBundleName</key>
	<string>AC Voice</string>
	<key>CFBundleDisplayName</key>
	<string>AC Voice</string>
	<key>CFBundleExecutable</key>
	<string>AC Voice</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleLocalizations</key>
	<array>
		<string>de</string>
		<string>en</string>
	</array>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD_NUMBER@</string>
	<key>NSHumanReadableCopyright</key>
	<string>© 2026 David Einenkel</string>
	<key>LSMinimumSystemVersion</key>
	<string>26.0</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.productivity</string>
	<key>LSUIElement</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticTermination</key>
	<false/>
	<key>NSSupportsSuddenTermination</key>
	<false/>
	<key>NSMicrophoneUsageDescription</key>
	<string>AC Voice listens only after you press its key or shortcut. Speech recognition runs entirely on this Mac.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>AC Voice recognizes your voice command on this Mac. No recording leaves the device.</string>
	<key>NSAppleEventsUsageDescription</key>
	<string>AC Voice opens projects and tickets in Google Chrome. It uses an open ActiveCollab tab or opens a new tab.</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>io.github.nordavid.acvoice</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>acvoice</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
